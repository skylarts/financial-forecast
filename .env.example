NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Encrypts every brokerage credential before it is stored -- the Schwab refresh
# token, and any app key and secret a user registers. Connecting is refused
# outright rather than storing one of these in the clear, so this is required
# wherever Schwab is used at all, the local file included.
# Generate with:  openssl rand -hex 32
SCHWAB_ENCRYPTION_KEY=

# The deployment's own Schwab app (optional). Create it at
# https://developer.schwab.com and register the callback URL below on it,
# character for character. Schwab only accepts https callbacks, so local
# development needs `npm run dev -- --experimental-https`.
#
# On a single-user install this is simply your app. On a deployment other
# people can sign in to, it is NOT lent out to them unless SCHWAB_SHARED_APP
# says so -- each user registers their own app in the UI instead. Schwab holds
# a registered app's owner responsible for its traffic, so this is a decision
# to make on purpose rather than one to inherit.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:3001/api/schwab/callback

# Set to "true" to let any signed-in user connect through the app credentials
# above instead of registering their own. Their brokerage data is still only
# ever theirs, but the traffic counts against your Schwab registration.
SCHWAB_SHARED_APP=

# Set to "true" to allow the unauthenticated single-user file mode in a
# production build. Only for an install that genuinely has one user and no
# Supabase -- it puts no authentication in front of /api/schwab/*, so anyone
# who can reach the URL can read the connected brokerage. Left unset, a
# production build that finds no Supabase config refuses to serve Schwab at
# all, which is the safe way round.
SCHWAB_ALLOW_SINGLE_USER=

# Where the single-user file keeps its (encrypted) credentials. Defaults to
# ./data/schwab-tokens.json. Worth pointing outside the project directory when
# that directory is synced -- iCloud Drive, Dropbox, a network share.
SCHWAB_TOKEN_PATH=
