NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Schwab (optional). Leave blank to price the portfolio from the public feed,
# which is what happens on any install that never connects a brokerage.
# Create an app at https://developer.schwab.com and register the callback URL
# below on it, character for character. Schwab only accepts https callbacks,
# so local development needs `npm run dev -- --experimental-https`.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:3001/api/schwab/callback

# Required only when Supabase is configured, i.e. any deployment. Encrypts the
# brokerage token before it is written to the database, so a dump or a leaked
# backup is not by itself a usable credential. Connecting is refused outright
# rather than storing one in plaintext, so this is not optional there.
# Generate with:  openssl rand -hex 32
SCHWAB_ENCRYPTION_KEY=
